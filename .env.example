# Bot token from @BotFather. Enable "Threaded Mode" for the bot in BotFather so it can create topics.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id. Leave empty on first run, send /start to the bot,
# and it will tell you the id to put here. Only this user can talk to agents.
OWNER_ID=

# Bearer token clients send to /mcp and /notify. Generate with: openssl rand -hex 32
MCP_TOKEN=

# Where to listen. Keep it on localhost and put a TLS reverse proxy in front.
HOST=127.0.0.1
PORT=8790

# Optional
# DATA_DIR=./data
# ASK_TIMEOUT_SEC=600
# RELAY_PERMISSIONS=1
# ROUTER=1   enable /router/wait and /router/ack for a local router (see README)

# Optional: transcribe voice notes (see README). Audio goes to this provider.
# STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# STT_LANGUAGE=ru   ISO-639-1 hint, auto-detected when unset
# STT_TIMEOUT_SEC=30
